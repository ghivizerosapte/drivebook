# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Supervisor account seeded by `make seed` / `python -m app.seed`.
# No hardcoded fallback: if unset, seed.py skips creating this account
# (a clear warning is printed) rather than baking in a default password.
DRIVEBOOK_SUPERVISOR_USERNAME=
DRIVEBOOK_SUPERVISOR_PASSWORD=
